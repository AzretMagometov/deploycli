{
  "name": "no-edge-fixture",
  "networks": {
    "default": {
      "name": "no-edge-fixture_default"
    }
  },
  "services": {
    "app": {
      "image": "myapp:1.0",
      "labels": {
        "traefik.enable": "true",
        "traefik.http.routers.app.rule": "Host(`app.example.com`)"
      },
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "8080",
          "target": 3000
        }
      ]
    }
  }
}
